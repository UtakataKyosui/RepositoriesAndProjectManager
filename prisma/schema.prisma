// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider                  = "prisma-zod-generator"
  output                    = "../src/lib/zod"
  isGenerateSelect          = true
  isGenerateInclude         = true
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  roadmaps      Roadmap[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum ProjectStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  published   Boolean       @default(false)
  status      ProjectStatus @default(TODO)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  repositories Repository[]
  dependencies ProjectDependency[] @relation("dependency")
  dependents   ProjectDependency[] @relation("dependent")
  roadmapProjects RoadmapProject[]

  @@map("project")
}

model Repository {
  id        String   @id @default(cuid())
  url       String
  name      String?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("repository")
}

model ProjectDependency {
  dependencyId String
  dependency   Project @relation("dependency", fields: [dependencyId], references: [id])
  dependentId  String
  dependent    Project @relation("dependent", fields: [dependentId], references: [id])

  @@id([dependencyId, dependentId])
  @@map("project_dependency")
}

model Roadmap {
  id          String        @id @default(cuid())
  title       String
  description String?
  published   Boolean       @default(false)
  status      ProjectStatus @default(TODO)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  goals    RoadmapGoal[]
  projects RoadmapProject[]

  @@map("roadmap")
}

model RoadmapGoal {
  id          String   @id @default(cuid())
  content     String
  order       Int      @default(0)
  isCompleted Boolean  @default(false)
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@map("roadmap_goal")
}

model RoadmapProject {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  roadmapId String
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, projectId])
  @@map("roadmap_project")
}
